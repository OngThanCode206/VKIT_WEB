@model VKITActivityManager.Models.HoatDongNoiBat
@{
    ViewData["Title"] = "Thêm Hoạt Động Mới";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header text-white p-4 border-0" style="background-color: #0A2540;">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-plus-circle me-2"></i> Thêm Hoạt Động Mới</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="CreateHDNB" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label class="form-label fw-bold" style="color: #475569;">Mô tả / Tiêu đề hoạt động <span class="text-danger">*</span></label>
                            <textarea asp-for="MoTa" class="form-control bg-light border-0 shadow-sm" rows="3" placeholder="Nhập nội dung ngắn gọn..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold" style="color: #475569;">Hình ảnh <span class="text-danger">*</span></label>
                            <input type="file" name="fileTaiLen" class="form-control bg-light border-0 shadow-sm" accept="image/*" required />
                            <small class="text-muted mt-2 d-block"><i class="fas fa-info-circle"></i> Khuyên dùng ảnh nằm ngang (Tỷ lệ 16:9) để hiển thị đẹp nhất.</small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="IndexHDNB" class="btn btn-light border fw-bold text-secondary px-4 py-2">
                                <i class="fas fa-arrow-left me-1"></i> Trở về
                            </a>
                            <button type="submit" class="btn fw-bold px-4 py-2 shadow-sm" style="background-color: #00D4B2; color: #0A2540;">
                                <i class="fas fa-save me-1"></i> Lưu Dữ Liệu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>