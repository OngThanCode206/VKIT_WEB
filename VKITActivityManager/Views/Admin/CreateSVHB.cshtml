@model VKITActivityManager.Models.SinhVienHocBong
@{
    ViewData["Title"] = "Thêm Sinh Viên Học Bổng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h4 class="fw-bold text-success mb-4"><i class="fas fa-plus-circle"></i> THÊM SINH VIÊN NHẬN HỌC BỔNG</h4>

    <form asp-action="CreateSVHB" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
        <div class="row mb-3">
            <div class="col-md-12 mb-3">
                <label class="fw-bold">Thuộc Loại Học Bổng Nào? <span class="text-danger">*</span></label>
                <select asp-for="LoaiHocBongId" class="form-select border-primary fw-bold text-primary" asp-items="ViewBag.LoaiHocBongId"></select>
            </div>

            <div class="col-md-4">
                <label class="fw-bold">Mã Sinh Viên</label>
                <input asp-for="MaSV" class="form-control" placeholder="Ví dụ: 22110..." />
            </div>
            <div class="col-md-4">
                <label class="fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                <input asp-for="TenSinhVien" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="fw-bold">Lớp</label>
                <input asp-for="Lop" class="form-control" placeholder="Ví dụ: 22DTH..." />
            </div>
        </div>

        <div class="mb-4">
            <label class="fw-bold">Ảnh Avatar Sinh Viên</label>
            <input type="file" name="fileAnh" class="form-control" accept="images/*" />
        </div>

        <div>
            <button type="submit" class="btn btn-success fw-bold"><i class="fas fa-save"></i> Lưu thông tin</button>
            <a href="/Admin" class="btn btn-secondary">Hủy</a>
        </div>
    </form>
    <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>
</div>