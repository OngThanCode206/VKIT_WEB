@model VKITActivityManager.Models.HoatDongNoiBat
@{
    ViewData["Title"] = "Chỉnh Sửa Hoạt Động";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header text-white p-4 border-0" style="background-color: #0A2540;">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i> Chỉnh Sửa Hoạt Động</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="EditHDNB" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label class="form-label fw-bold" style="color: #475569;">Mô tả / Tiêu đề hoạt động <span class="text-danger">*</span></label>
                            <textarea asp-for="MoTa" class="form-control bg-light border-0 shadow-sm" rows="3"></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold" style="color: #475569;">Ảnh hiện tại</label>
                            <div class="d-block mb-3">
                                <img src="@Model.DuongDanAnh" alt="Current Image" class="img-thumbnail shadow-sm rounded-3" style="max-height: 200px; object-fit: cover;" />
                            </div>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold" style="color: #475569;">Đổi hình ảnh mới (Bỏ trống nếu giữ nguyên)</label>
                            <input type="file" name="fileTaiLen" class="form-control bg-light border-0 shadow-sm" accept="image/*" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="IndexHDNB" class="btn btn-light border fw-bold text-secondary px-4 py-2">
                                <i class="fas fa-arrow-left me-1"></i> Hủy & Trở về
                            </a>
                            <button type="submit" class="btn fw-bold px-4 py-2 shadow-sm text-white" style="background-color: #0A2540;">
                                <i class="fas fa-check-circle me-1"></i> Cập Nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>