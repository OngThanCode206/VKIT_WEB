@model VKITActivityManager.Models.HoatDongChuyenNganh
@{
    ViewData["Title"] = "Thêm hoạt động ngành";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h4 class="fw-bold text-success mb-4"><i class="fas fa-plus-circle"></i> THÊM HOẠT ĐỘNG CHUYÊN NGÀNH</h4>

    <form asp-action="CreateHDCN" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="fw-bold">Chọn Chuyên Ngành</label>
                <select asp-for="ChuyenNganhId" class="form-select border-primary text-primary fw-bold" asp-items="ViewBag.ChuyenNganhId"></select>
            </div>
            <div class="col-md-6">
                <label class="fw-bold">Chọn Ảnh Bìa</label>
                <input type="file" name="hinhAnh" class="form-control" accept="image/*" />
            </div>
        </div>
        <div class="mb-3">
            <label class="fw-bold">Tiêu đề chính</label>
            <input asp-for="TieuDe" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="fw-bold">Tiêu đề phụ (Badge)</label>
            <input asp-for="TieuDePhu" class="form-control" />
        </div>
        <div class="mb-4">
            <label class="fw-bold">Nội dung chi tiết</label>
            <textarea asp-for="NoiDung" class="form-control" id="editorNoiDung" rows="6"></textarea>
        </div>
        <div>
            <button type="submit" class="btn btn-success fw-bold"><i class="fas fa-save"></i> Lưu bài viết</button>
            <a asp-action="IndexHDCN"
               class="btn btn-secondary">
                Hủy
            </a>
        </div>
    </form>
</div>