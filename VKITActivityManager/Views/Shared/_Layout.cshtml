<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>@ViewData["Title"] - VKIT University</title>
    <link rel="icon" type="images/*" href="~/images/logovkit.ico" />
    <link rel="shortcut icon" type="images/*" href="~/images/logovkit.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

 <style>
    :root {
        --vlu-red: #c62828;
        --vlu-dark: #1a237e;
    }
    body {
        font-family: 'Segoe UI', Tahoma, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        overflow-x: hidden;
    }

    /* KHUNG MENU CHÍNH - KHÓA CỨNG BỐ CỤC */
    .main-nav {
        background: #fff;
        border-bottom: 3px solid var(--vlu-red);
        padding: 10px 0;
        width: 100%;
        display: block;
    }

    .main-nav .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }

    /* KHÓA CỨNG KÍCH THƯỚC 2 LOGO */
    .hutech-logo, .vkit-logo {
        height: 60px; /* Chiều cao cố định trên Desktop */
        width: auto;
        object-fit: contain;
        mix-blend-mode: multiply;
        transition: all 0.3s ease;
    }

    /* KHÓA TIÊU ĐỀ Ở GIỮA */
    .title-container {
        flex-grow: 1;
        text-align: center;
        padding: 0 15px;
    }

    .title-text {
        color: var(--vlu-dark);
        font-size: 22px;
        font-weight: 700;
        white-space: nowrap; /* Không bao giờ xuống dòng */
        margin: 0;
    }

    /* DẢI BANNER ĐỎ BÊN DƯỚI */
    .vlu-sub-header {
        background: var(--vlu-red);
        color: white;
        padding: 8px 0;
        font-weight: bold;
        text-align: center;
        font-size: 14px;
        width: 100%;
    }

    /* RESPONSIVE CHO ĐIỆN THOẠI */
    @@media (max-width: 991px) {
        .hutech-logo, .vkit-logo {
            height: 40px; /* Thu nhỏ logo trên mobile */
        }
        .title-text {
            font-size: 13px; /* Thu nhỏ chữ trên mobile */
        }
        .main-nav {
            padding: 5px 0;
        }
    }

    .qr-hover-effect {
        transition: transform 0.2s ease-in-out;
    }

    .qr-hover-effect:hover {
        transform: scale(1.05);
    }
</style>
</head>
<body>

   <nav class="main-nav">
    <div class="container d-flex align-items-center justify-content-between">
        
        <a href="/" class="brand-link">
            <img src="/images/hoatdong/logoht.jpg" class="hutech-logo" alt="HUTECH" />
        </a>

        <div class="title-container text-center">
            <h3 class="m-0 fw-bold title-text">
                VIỆN CÔNG NGHỆ <span style="color: var(--vlu-red);">VIỆT HÀN</span>
            </h3>
        </div>

        <a href="/" class="brand-link">
            <img src="/images/hoatdong/logoviethan.jpg" class="vkit-logo" alt="VIỆT HÀN" />
        </a>

    </div>
</nav>

    <div class="vlu-sub-header shadow-sm">
        <div class="container text-truncate">
            NĂNG ĐỘNG SÁNG TẠO <i class="fas fa-star mx-1 text-warning"></i> BỨT PHÁ TƯƠNG LAI
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="text-white pt-4 pb-3 mt-auto" style="background-color: #1a1a1a; font-size: 0.95rem;">
        <div class="container text-center">
            <div class="row">
                <div class="col-12 mx-auto">
                    <h5 class="fw-bold mb-3" style="color: #ffff; letter-spacing: 1px;">
                        VIỆN CÔNG NGHỆ VIỆT HÀN (VKIT) | TRƯỜNG ĐẠI HỌC CÔNG NGHỆ TP.HCM (HUTECH)
                    </h5>

                    <p class="mb-2">
                        <i class="fas fa-map-marker-alt me-2 text-danger"></i>
                        Trụ sở Điện Biên Phủ: 475A Điện Biên Phủ, Phường Thạnh Mỹ Tây, TP.HCM
                    </p>

                    <p class="mb-2 d-flex flex-wrap justify-content-center align-items-center gap-2 gap-md-3">
                        <span><i class="fas fa-phone-alt me-2" style="color: #4caf50;"></i>Điện thoại: (028) 3556 6109</span>
                        <span class="d-none d-md-inline text-secondary">|</span>
                        <span><i class="fas fa-comment-dots me-2" style="color: #0088cc;"></i>Zalo: 0397 953 837 (Thầy Thanh Vang)</span>
                        <span class="d-none d-md-inline text-secondary">|</span>
                        <span><i class="fas fa-envelope me-2" style="color: #ff9800;"></i>Email: vkit@hutech.edu.vn</span>
                    </p>

                    <p class="mb-3">
                        <i class="fas fa-globe me-2 text-primary"></i>Website:
                        <a href="https://www.hutech.edu.vn/chuong-trinh-viet-han-vkit" target="_blank" class="text-white text-decoration-none custom-link">
                            hutech.edu.vn/VKIT
                        </a>
                    </p>

                    <hr class="mb-3 mx-auto" style="border-color: #444; width: 80%;">

                    <div class="small" style="color: #aaa;">
                        &copy; @DateTime.Now.Year - Bản quyền thuộc về Viện Công Nghệ Việt Hàn (VKIT)
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <style>
        .custom-link {
            transition: color 0.3s ease;
        }

            .custom-link:hover {
                color: #f8ca00 !important;
                text-decoration: underline !important;
            }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- NÚT ĐĂNG KÝ XÉT TUYỂN (NẰM TRÊN NÚT CHAT) -->
    <a href="https://www.hutech.edu.vn/chuong-trinh-viet-han-vkit#dangky" target="_blank" 
       id="vkit-register-btn" 
       class="position-fixed d-flex align-items-center justify-content-center shadow-lg text-decoration-none btn-register-pulse"
       style="bottom: 110px; right: 30px; width: 65px; height: 65px; border-radius: 50%; background: linear-gradient(135deg, #e53935, #c62828); z-index: 9998;">
        
        <!-- Icon cái bút/đăng ký -->
        <i class="fas fa-file-signature text-white fs-3"></i>
        
        <!-- Bong bóng text trỏ ra bên trái -->
        <div class="position-absolute bg-white shadow-sm rounded p-2 text-center" style="right: 80px; width: 140px; font-size: 13px; font-weight: 600; border: 1px solid #e0e0e0;">
            <span class="text-primary">Tuyển sinh 2026</span><br />
            <span class="text-danger">ĐĂNG KÝ NGAY</span>
            <!-- Hình tam giác chỉ vào nút -->
            <div class="position-absolute" style="top: 50%; right: -6px; width: 12px; height: 12px; background: white; transform: translateY(-50%) rotate(45deg); border-right: 1px solid #e0e0e0; border-top: 1px solid #e0e0e0;"></div>
        </div>
    </a>
    <div id="vkit-chat-btn" class="position-fixed shadow-lg"
         style="bottom: 30px; right: 30px; width: 65px; height: 65px; border-radius: 50%; z-index: 9999; cursor: pointer; border: 3px solid #fff; overflow: hidden;">
        <img src="/images/hoatdong/logochibiVKIT.png" alt="VKIT Chibi" style="width: 100%; height: 100%; object-fit: cover;">
    </div>

    <div class="position-fixed bg-white shadow-sm rounded p-2 text-center"
         style="bottom: 40px; right: 110px; width: 140px; font-size: 13px; font-weight: 600; border: 1px solid #e0e0e0; z-index: 9998; pointer-events: none;">
        <span class="text-primary">VKIT - Trợ lý ảo</span><br />
        <span class="text-danger">Tư vấn tuyển sinh</span>
        <div class="position-absolute" style="top: 50%; right: -6px; width: 12px; height: 12px; background: white; transform: translateY(-50%) rotate(45deg); border-right: 1px solid #e0e0e0; border-top: 1px solid #e0e0e0;"></div>
    </div>

    <div id="vkit-chat-window" class="position-fixed d-none flex-column bg-white">
        <!-- Header --> <div class="vkit-header text-white p-3 d-flex justify-content-between align-items-center"> 
            <div class="d-flex align-items-center"> <div class="vkit-avatar me-3"> <i class="fas fa-robot"></i> </div>
            <div> <h6 class="m-0 fw-bold"> 🤖 VKIT AI Assistant </h6> <small class="vkit-status"> <i class="fas fa-circle"></i> Đồng hành cùng tân sinh viên </small>
            </div> </div> <i class="fas fa-times fs-5" id="close-chat"></i> </div>
            <!-- Chat History -->
            <div id="chat-history" class="p-3 flex-grow-1">
            <!-- Message mặc định --> 
            <div class="d-flex justify-content-start mb-3"> 
            <div class="vkit-bot-message"> 👋 Xin chào! <br>
            <br> Mình là <b>VKIT AI Assistant</b> 🎓 <br>
            <br> Mình có thể hỗ trợ bạn: <br> ✨ Các câu hỏi tuyển sinh thường gặp <br> 🎓 Các ngành đào tạo <br> 💰 Học phí và học bổng <br> 📅 Thông tin nhập học <br>
            <br> Bạn muốn tìm hiểu điều gì hôm nay? </div>
            </div> 
            <div id="chatbox-options-area" class="d-flex flex-column gap-2 mb-3"> </div>
            </div> <!-- Input --> <div class="vkit-input-area"> 
            <div class="input-group"> <input type="text" id="chat-user-input" class="form-control border-0 px-3" placeholder="Hỏi VKIT AI điều gì đó..." />
            <button class="btn" id="btn-send-chat" type="button"> <i class="fas fa-paper-plane"></i> 
                </button> 
           </div> 
       </div> 
    </div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    const chatBtn = document.getElementById('vkit-chat-btn');
    const chatWindow = document.getElementById('vkit-chat-window');
    const closeBtn = document.getElementById('close-chat');
    const optionsArea = document.getElementById('chatbox-options-area');
    const chatInput = document.getElementById('chat-user-input');
    const sendBtn = document.getElementById('btn-send-chat');

    let localDbData = [];
    let dataLoaded = false;

    const danhSachNganh = [
    { id: 1, name: "Công nghệ thông tin" }, { id: 2, name: "Công nghệ kỹ thuật ô tô" },
    { id: 3, name: "Quản trị kinh doanh" }, { id: 4, name: "Thiết kế đồ họa" },
    { id: 5, name: " CÔNG NGHỆ Ô TÔ ĐIỆN" }, { id: 6, name: "Tài chính – Ngân hàng" },
    { id: 7, name: "Ngôn ngữ Hàn Quốc" }, { id: 8, name: "Logistics & Quản lý chuỗi cung ứng" },
    { id: 9, name: " DIGITAL MARKETING" }
    ];

    // --- CÁC HÀM GIAO DIỆN (GIỮ NGUYÊN) ---
    chatBtn.addEventListener('click', function () {
    chatWindow.classList.toggle('d-none');
    chatWindow.classList.toggle('d-flex');
    if (!chatWindow.classList.contains('d-none') && !dataLoaded) loadDatabaseQuestions();
    });

    closeBtn.addEventListener('click', function () {
    chatWindow.classList.add('d-none');
    chatWindow.classList.remove('d-flex');
    });

    function loadDatabaseQuestions() {
    fetch('/Home/GetChatboxData?t=' + new Date().getTime())
    .then(res => res.json())
    .then(data => { localDbData = data; dataLoaded = true; showInitialMenu(); })
    .catch(err => { showInitialMenu(); });
    }

    function showInitialMenu() {
    optionsArea.innerHTML = '';
    createOptionButton("✨ <b>Các câu hỏi tuyển sinh thường gặp</b>", function () { appendMessage("Các câu hỏi tuyển sinh thường gặp", "user"); renderGeneralQuestions(); });
    createOptionButton("🎓 <b>Các ngành đào tạo</b>", function () { appendMessage("Các ngành đào tạo", "user"); renderMajorsList(); });
    }

    function renderMajorsList() {
    optionsArea.innerHTML = '<div class="text-muted small mb-2 fw-bold">Chọn ngành bạn muốn tìm hiểu</div>';
    danhSachNganh.forEach(nganh => {
    createOptionButton("🎓 " + nganh.name, function () {
    appendMessage("Tìm hiểu ngành " + nganh.name, "user");
    const found = localDbData.find(x => x.phanLoai === nganh.id);
    setTimeout(() => {
    appendMessage(found ? found.traLoi : "Thông tin ngành này đang cập nhật.", "bot");
    if (!found) appendQRCodeBox();
    showBackToMenuOption();
    }, 400);
    });
    });
    }

    function renderGeneralQuestions() {
    optionsArea.innerHTML = '<div class="text-muted small mb-2 fw-bold">Câu hỏi tân sinh viên quan tâm</div>';
    localDbData.filter(x => x.phanLoai === 0).forEach(item => {
    createOptionButton("❓ " + item.cauHoi, function () {
    appendMessage(item.cauHoi, "user");
    setTimeout(() => { appendMessage(item.traLoi, "bot"); showBackToMenuOption(); }, 400);
    });
    });
    }

    // --- HÀM CHAT AI MỚI (THAY THẾ LOGIC CŨ) ---
    function handleUserTextInput() {
    const query = chatInput.value.trim();
    if (!query) return;

    appendMessage(query, "user");
    chatInput.value = '';

    const typingId = "bot-typing-" + new Date().getTime();
    appendMessage('<div id="' + typingId + '"><i class="fas fa-spinner fa-spin"></i> VKIT AI đang suy nghĩ...</div>', "bot");

    fetch('/Home/AskAI', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'userQuestion=' + encodeURIComponent(query)
    })
    .then(res => res.json())
    .then(data => {
    document.getElementById(typingId).parentElement.parentElement.remove();
    if (data.success) {
    appendMessage(data.answer, "bot");
    } else {
    appendMessage(data.answer, "bot");
    }
    showBackToMenuOption();
    })
    .catch(() => {
    document.getElementById(typingId).parentElement.parentElement.remove();
    appendMessage("Dạ hệ thống AI đang tạm bận, bạn vui lòng liên hệ hotline nhé!", "bot");
    });
    }

    // --- CÁC HÀM TIỆN ÍCH (GIỮ NGUYÊN) ---
    function appendQRCodeBox() { /* ... Giữ nguyên nội dung hàm cũ ... */ }
    function createOptionButton(text, clickEvent) {
    let btn = document.createElement('button');
    btn.className = 'btn btn-outline-primary text-start shadow-sm py-2 px-3 fw-bold bg-white mb-2';
    btn.style.borderRadius = '12px'; btn.innerHTML = text; btn.onclick = clickEvent;
    optionsArea.appendChild(btn);
    }
    function showBackToMenuOption() {
    optionsArea.innerHTML = '';
    createOptionButton("🏠 Quay lại menu chính", showInitialMenu);
    }
    function appendMessage(text, sender) {
    const history = document.getElementById('chat-history');
    const msgDiv = document.createElement('div');
    msgDiv.className = sender === 'user' ? 'd-flex justify-content-end mb-3' : 'd-flex justify-content-start mb-3';
    msgDiv.innerHTML = sender === 'user' ? `<div class="vkit-user-message p-2 bg-primary text-white rounded">${text}</div>`
    : `<div class="vkit-answer-message p-2 border rounded">${text}</div>`;
    history.insertBefore(msgDiv, optionsArea);
    history.scrollTop = history.scrollHeight;
    }

    sendBtn.addEventListener('click', handleUserTextInput);
    chatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') handleUserTextInput(); });
    });
</script>
</body>
</html>