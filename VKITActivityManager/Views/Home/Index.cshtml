<script>
    function openLightbox(element) {
        document.getElementById('lightboxImage').src = element.getAttribute('data-img');
        document.getElementById('lightboxCaption').innerText = element.getAttribute('data-caption');
        new bootstrap.Modal(document.getElementById('lightboxModal')).show();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const scrollArea = document.getElementById('hdnbScrollArea');
        const btnPrev = document.getElementById('btnPrevHDNB');
        const btnNext = document.getElementById('btnNextHDNB');

        if (scrollArea && btnPrev && btnNext) {
            let autoPlayTimer;
            const originalHTML = scrollArea.innerHTML;
            scrollArea.innerHTML += originalHTML;

            function getScrollAmount() {
                const firstCard = scrollArea.querySelector('.hdnb-card-item');
                return firstCard ? (firstCard.offsetWidth + 24) : 400;
            }

            // Tối ưu JS chặn giật layout
            function slideNext() {
                const halfWidth = scrollArea.scrollWidth / 2;
                if (scrollArea.scrollLeft >= halfWidth) {
                    scrollArea.scrollLeft = scrollArea.scrollLeft - halfWidth;
                }
                requestAnimationFrame(() => {
                    scrollArea.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
                });
            }

            function slidePrev() {
                const halfWidth = scrollArea.scrollWidth / 2;
                if (scrollArea.scrollLeft <= 0) {
                    scrollArea.scrollLeft = halfWidth;
                }
                requestAnimationFrame(() => {
                    scrollArea.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
                });
            }

            btnNext.addEventListener('click', () => { slideNext(); resetTimer(); });
            btnPrev.addEventListener('click', () => { slidePrev(); resetTimer(); });

            function startTimer() {
                autoPlayTimer = setInterval(slideNext, 2000);
            }

            function resetTimer() {
                clearInterval(autoPlayTimer);
                startTimer();
            }

            scrollArea.addEventListener('mouseenter', () => clearInterval(autoPlayTimer));
            scrollArea.addEventListener('mouseleave', startTimer);
            startTimer();
        }
    });
</script>

