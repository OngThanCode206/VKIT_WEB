    .vd-scroll-area,
    .hb-scroll-area,
    #videoScrollArea {
        overflow-anchor: none;
        -webkit-overflow-scrolling: touch;
    }

    .vlu-hero-carousel {
        width: 100%;
        position: relative;
        background-color: #f8fafc;
        overflow: hidden;
    }

    .vlu-banner-img {
        width: 100%;
        max-height: 85vh;
        height: auto;
        object-fit: contain;
        margin: 0 auto;
        display: block;
        filter: brightness(0.98) contrast(1.02);
    }

    @@media (max-width: 991px) {
        .vlu-banner-img {
            width: 100%;
            max-height: none;
            height: auto;
            object-fit: contain;
        }
    }

    /* CẢM NHẬN SINH VIÊN */
