                                        else
                                        {
                                            <div class="text-muted small fst-italic">Đang cập nhật</div>
                                        }
                                    </div>

                                </div>
                            </div>
                        }
                    }

                </div>

                <button id="btnNextVD" class="btn btn-light rounded-circle shadow position-absolute top-50 translate-middle-y z-3" style="width: 45px; height: 45px; right: 0px;"><i class="fas fa-chevron-right"></i></button>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const scrollAreaHB = document.getElementById('hbScrollArea');
        const btnPrevHB = document.getElementById('btnPrevHB');
        const btnNextHB = document.getElementById('btnNextHB');

        if (scrollAreaHB && btnPrevHB && btnNextHB) {
            btnNextHB.addEventListener('click', () => {
                const firstCard = scrollAreaHB.querySelector('.k-duo-scholarship-box');
                const scrollAmount = firstCard ? firstCard.offsetWidth + 30 : 580;
                scrollAreaHB.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            });

            btnPrevHB.addEventListener('click', () => {
                const firstCard = scrollAreaHB.querySelector('.k-duo-scholarship-box');
                const scrollAmount = firstCard ? firstCard.offsetWidth + 30 : 580;
                scrollAreaHB.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            });

            scrollAreaHB.addEventListener('scroll', function () {
                btnPrevHB.disabled = scrollAreaHB.scrollLeft <= 0;
                btnNextHB.disabled = scrollAreaHB.scrollLeft >= (scrollAreaHB.scrollWidth - scrollAreaHB.clientWidth - 2);
            });
            scrollAreaHB.dispatchEvent(new Event('scroll'));
        }

        const scrollAreaVD = document.getElementById('vdScrollArea');
        const btnPrevVD = document.getElementById('btnPrevVD');
        const btnNextVD = document.getElementById('btnNextVD');

        if (scrollAreaVD && btnPrevVD && btnNextVD) {
            let autoPlayTimerVD;
            const originalHTMLVD = scrollAreaVD.innerHTML;
            scrollAreaVD.innerHTML += originalHTMLVD;

            function getScrollAmountVD() {
                const firstCard = scrollAreaVD.querySelector('.vd-card-item');
                return firstCard ? (firstCard.offsetWidth + 24) : 300;
            }

            // Tối ưu JS chặn giật layout cho Vinh Danh Slider
            function slideNextVD() {
                const halfWidth = scrollAreaVD.scrollWidth / 2;
                if (scrollAreaVD.scrollLeft >= halfWidth) {
                    scrollAreaVD.scrollLeft = scrollAreaVD.scrollLeft - halfWidth;
                }
                requestAnimationFrame(() => {
                    scrollAreaVD.scrollBy({ left: getScrollAmountVD(), behavior: 'smooth' });
                });
            }

            function slidePrevVD() {
                const halfWidth = scrollAreaVD.scrollWidth / 2;
                if (scrollAreaVD.scrollLeft <= 0) {
                    scrollAreaVD.scrollLeft = halfWidth;
                }
                requestAnimationFrame(() => {
                    scrollAreaVD.scrollBy({ left: -getScrollAmountVD(), behavior: 'smooth' });
                });
            }

            btnNextVD.addEventListener('click', () => { slideNextVD(); resetTimerVD(); });
            btnPrevVD.addEventListener('click', () => { slidePrevVD(); resetTimerVD(); });

            function startTimerVD() {
                autoPlayTimerVD = setInterval(slideNextVD, 2500);
            }

            function resetTimerVD() {
                clearInterval(autoPlayTimerVD);
                startTimerVD();
            }

            scrollAreaVD.addEventListener('mouseenter', () => clearInterval(autoPlayTimerVD));
            scrollAreaVD.addEventListener('mouseleave', startTimerVD);
            startTimerVD();
        }

        var pressEl = document.querySelector('#pressSlider');
        if (pressEl) {
            var pCarousel = new bootstrap.Carousel(pressEl, {
                interval: 3500,
                wrap: true,
                pause: 'hover'
            });
            pCarousel.cycle();
        }

        var testimonialEl = document.querySelector('#testimonialCarousel');
        if (testimonialEl) {
            var tCarousel = new bootstrap.Carousel(testimonialEl, {
                interval: 3000,
                wrap: true
            });
            tCarousel.cycle();
        }
    });
</script>

