        </div>
    </section>
    @{
        // 1. LẤY TOÀN BỘ DANH SÁCH HỌC PHÍ
        var allHocPhi = ViewBag.DanhSachHocPhi as List<VKITActivityManager.Models.HocPhi> ?? new List<VKITActivityManager.Models.HocPhi>();

        // 2. GOM NHÓM LẠI THEO NGÀNH VÀ THỜI GIAN HỌC
        var groups = allHocPhi.GroupBy(x => new { x.NganhDaoTao, x.ThoiGian }).ToList();

        // 3. HÀM TỰ ĐỘNG NHẬN DIỆN ICON THEO TÊN NGÀNH
        string GetIconTheoNganh(string nganh)
        {
            if (string.IsNullOrEmpty(nganh)) return "fas fa-graduation-cap";
            var n = nganh.ToLower();
            if (n.Contains("ô tô điện")) return "fas fa-charging-station";
            if (n.Contains("ô tô")) return "fas fa-car";
            if (n.Contains("thông tin")) return "fas fa-laptop-code";
            if (n.Contains("marketing")) return "fas fa-bullhorn";
            if (n.Contains("logistics") || n.Contains("chuỗi")) return "fas fa-truck-fast";
            if (n.Contains("công chúng")) return "fas fa-users-rays";
            if (n.Contains("kinh doanh")) return "fas fa-briefcase";
            if (n.Contains("tài chính") || n.Contains("ngân hàng")) return "fas fa-coins";
            if (n.Contains("du lịch") || n.Contains("khách sạn")) return "fas fa-plane-departure";
            if (n.Contains("ngôn ngữ")) return "fas fa-language";
            return "fas fa-graduation-cap";
        }

        // 4. HÀM CHỨC NĂNG: GOM NHÓM KỸ THUẬT 1 MÀU - CỬ NHÂN 1 MÀU
        string GetMauTheoNganh(string nganh)
        {
            // Màu Khối Cử nhân (Xanh ngọc) - Dùng làm mặc định
            string mauCuNhan = "#0D9488";

            // Màu Khối Kỹ Thuật (Xanh dương)
            string mauKyThuat = "#2563EB";

            if (string.IsNullOrEmpty(nganh)) return mauCuNhan;

            var n = nganh.ToLower();
            // Kiểm tra xem có phải khối Kỹ thuật không
            if (n.Contains("kỹ thuật") ||
                n.Contains("công nghệ") ||
                n.Contains("ô tô") ||
                n.Contains("điện") ||
                n.Contains("tin học"))
            {
                return mauKyThuat;
            }

            // Nếu không thuộc nhóm kỹ thuật thì trả về màu Cử nhân
            return mauCuNhan;
        }
    }

    <div class="tuition-section">
        <h2 class="fw-bold text-center tuition-title mb-5">
            HỌC PHÍ NĂM 2026 VÀ <br /> ĐƯỢC TÍNH THEO CHƯƠNG TRÌNH ĐÀO TẠO CHUẨN VIỆT HÀN
        </h2>

        @if (groups.Any())
        {
            <div class="accordion shadow-sm" id="accordionHocPhi" style="border-radius: 12px; overflow: hidden;">
                @{
                    int idx = 0;
                }
                @foreach (var group in groups)
                {
                    var collapseId = "collapse_" + idx;
                    var headingId = "heading_" + idx;
                    var items = group.ToList();

                    string currentIcon = GetIconTheoNganh(group.Key.NganhDaoTao);

                    // GỌI HÀM CHỨC NĂNG Ở ĐÂY (Hết báo lỗi)
                    string currentColor = GetMauTheoNganh(group.Key.NganhDaoTao);

                    <div class="accordion-item border-0 border-bottom">

                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId" style="font-size: 1.1rem; color: @currentColor; background-color: #f8fafc;">
                                <div class="d-flex align-items-center justify-content-between flex-grow-1 me-3">
                                    <span class="text-start">
                                        <i class="@currentIcon me-3 fs-5"></i>@group.Key.NganhDaoTao
                                    </span>
                                    <span class="badge px-3 py-2 text-white shadow-sm flex-shrink-0" style="font-size: 0.8rem; font-weight: 500; background-color: @currentColor; border-radius: 6px;">
                                        Thời gian học: @group.Key.ThoiGian
                                    </span>
                                </div>
                            </button>
                        </h2>

                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#accordionHocPhi">
                            <div class="accordion-body p-0 bg-white">

                                <!-- BẢNG PC -->
                                <div class="table-responsive d-none d-md-block">
                                    <table class="table table-bordered text-center align-middle mb-0" style="border-color: #F1F5F9;">
                                        <thead style="background-color: @currentColor; color: white;">
                                            <tr>
                                                <th style="min-width: 250px;" class="py-3 border-0">Đơn vị áp dụng</th>
                                                <th style="min-width: 140px;" class="py-3 border-0">Học phí<br />(VNĐ)</th>
                                                <th style="min-width: 180px;" class="py-3 border-0">Học phí sau học bổng 25%<br />(VNĐ)</th>
                                                <th style="min-width: 180px;" class="py-3 border-0">Học phí sau học bổng 50%<br />(VNĐ)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in items)
                                            {
                                                <tr class="@(item.LaDongPhu ? "bg-light" : "")" style="transition: background-color 0.2s ease;">
                                                    <td class="fw-bold py-3 px-3 text-start" style="color: @currentColor; border-color: #F1F5F9;">@item.DonViApDung</td>
                                                    <td class="text-primary fw-bold py-3" style="border-color: #F1F5F9;">@item.MucHocPhi</td>
                                                    <td class="text-danger fw-bold py-3" style="border-color: #F1F5F9;">@item.HocPhiGiam25</td>
                                                    <td class="text-danger fw-bold py-3" style="border-color: #F1F5F9;">@item.HocPhiGiam50</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- DẠNG THẺ MOBILE -->
                                <div class="d-block d-md-none p-3 bg-light">
                                    <div class="tuition-mobile-card shadow-sm" style="border: 2px solid @currentColor; border-radius: 12px; overflow: hidden; background-color: #fff;">

                                        @for (int i = 0; i < items.Count; i++)
                                        {
                                            var item = items[i];

                                            <div class="text-white" style="background-color: @currentColor; padding: 10px 15px; font-weight: 600; text-align: center; font-size: 0.95rem;">
                                                @item.DonViApDung
                                            </div>

                                            <div class="d-flex justify-content-between p-3" style="background-color: @(item.LaDongPhu ? "#f8f9fa" : "#ffffff"); border-bottom: 1px solid #f1f5f9;">

                                                <div class="w-50" style="border-right: 1px dashed #dee2e6; padding-right: 15px;">
                                                    <p class="mb-2 text-dark fw-bold" style="font-size: 0.9rem;">Học phí gốc</p>
                                                    <p class="mb-2" style="color: #0d6efd; font-size: 0.9rem;">Học bổng 25%</p>
                                                    <p class="mb-0" style="color: #0d6efd; font-size: 0.9rem;">Học bổng 50%</p>
                                                </div>

                                                <div class="w-50 text-end" style="padding-left: 15px;">
                                                    <p class="mb-2 text-dark fw-bold" style="font-size: 0.9rem;">@item.MucHocPhi</p>
                                                    <p class="mb-2 text-danger fw-bold" style="font-size: 0.9rem;">@item.HocPhiGiam25</p>
                                                    <p class="mb-0 text-danger fw-bold" style="font-size: 0.9rem;">@item.HocPhiGiam50</p>
                                                </div>
                                            </div>
                                        }

                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                    idx++;
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted fst-italic card shadow-sm border-0">
                Chưa có thông tin học phí các ngành đào tạo.
            </div>
        }
    </div>

    <div class="vkit-scholarship-section py-5 my-4">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between mb-5 position-relative">
                <div class="title-wrapper">
                    <span class="text-uppercase fw-bold text-primary tracking-wider small d-block mb-1" style="letter-spacing: 2px; color: #4f46e5 !important;">VKIT SCHOLARSHIP FUND</span>
                    <h2 class="fw-black m-0" style="color: #0f172a; font-weight: 800; font-size: 2rem;">
                        Các Loại Học Bổng Hiện Hành Năm 2025
                    </h2>
