    <script>
        // Hàm mở ảnh to
        function openLightbox(element) {
            document.getElementById('lightboxImage').src = element.getAttribute('data-img');
            document.getElementById('lightboxCaption').innerText = element.getAttribute('data-caption');
            new bootstrap.Modal(document.getElementById('lightboxModal')).show();
        }

        // Logic Slider lặp vô tận (Infinite Carousel)
        document.addEventListener("DOMContentLoaded", function () {
            const scrollArea = document.getElementById('hdnbScrollArea');
            const btnPrev = document.getElementById('btnPrevHDNB');
            const btnNext = document.getElementById('btnNextHDNB');

            if (scrollArea && btnPrev && btnNext) {
                let autoPlayTimer;

                // THỦ THUẬT: Nhân đôi toàn bộ danh sách thẻ để tạo ảo giác cuộn dài vô tận
                const originalHTML = scrollArea.innerHTML;
                scrollArea.innerHTML += originalHTML;

                // Lấy khoảng cách mỗi lần lướt (Bằng độ rộng 1 thẻ + 24px khoảng cách)
                function getScrollAmount() {
                    const firstCard = scrollArea.querySelector('.hdnb-card-item');
                    return firstCard ? (firstCard.offsetWidth + 24) : 400;
                }

                // Hàm lướt qua phải (Tiến tới)
                function slideNext() {
                    const halfWidth = scrollArea.scrollWidth / 2; // Chiều dài của danh sách gốc

                    // Nếu đã cuộn qua hết phần gốc, âm thầm "dịch chuyển tức thời" về vị trí tương ứng ở phần copy
                    if (scrollArea.scrollLeft >= halfWidth) {
                        scrollArea.scrollTo({ left: scrollArea.scrollLeft - halfWidth, behavior: 'auto' }); // auto = không mượt, giật ngay lập tức
                    }

                    // Đợi 10 mili-giây để trình duyệt xử lý xong cú dịch chuyển, sau đó cuộn mượt mà lên thẻ tiếp theo
                    setTimeout(() => {
                        scrollArea.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
                    }, 10);
                }

                // Hàm lướt qua trái (Lùi lại)
                function slidePrev() {
                    const halfWidth = scrollArea.scrollWidth / 2;

                    // Nếu đang ở sát lề trái mà bấm lùi, âm thầm "dịch chuyển tức thời" tới giữa danh sách
                    if (scrollArea.scrollLeft <= 0) {
                        scrollArea.scrollTo({ left: halfWidth, behavior: 'auto' });
                    }

                    setTimeout(() => {
                        scrollArea.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
                    }, 10);
                }

                // Gắn sự kiện cho 2 nút bấm
                btnNext.addEventListener('click', () => { slideNext(); resetTimer(); });
                btnPrev.addEventListener('click', () => { slidePrev(); resetTimer(); });

                // Hẹn giờ tự động trượt sang phải (2000ms = 2 giây)
                function startTimer() {
                    autoPlayTimer = setInterval(slideNext, 2000);
                }

                function resetTimer() {
                    clearInterval(autoPlayTimer);
                    startTimer();
                }

                // Dừng cuộn khi rê chuột vào, tiếp tục khi rút chuột ra
                scrollArea.addEventListener('mouseenter', () => clearInterval(autoPlayTimer));
                scrollArea.addEventListener('mouseleave', startTimer);

                // Khởi động!
                startTimer();
            }
        });
    </script>

