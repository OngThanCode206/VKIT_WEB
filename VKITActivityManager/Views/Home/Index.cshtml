                                        <div class="d-flex align-items-center justify-content-between mb-4">
                                            <div class="kor-badge" style="background-color: var(--hb-color);">
                                                <i class="fas fa-award me-1"></i>
                                                @(item.SoSuat < 10 ? "0" + item.SoSuat : item.SoSuat.ToString()) SUẤT
                                            </div>
                                        </div>

                                        <h4 class="card-title fw-bold text-dark mb-3 kor-card-title">@item.TenHocBong</h4>
                                        <div class="w-25 my-3" style="height: 2px; background-color: var(--hb-color); opacity: 0.3;"></div>

                                        @if (!string.IsNullOrEmpty(item.MoTa))
