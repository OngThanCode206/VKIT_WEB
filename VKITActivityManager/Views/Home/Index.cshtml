@model IEnumerable<VKITActivityManager.Models.HoatDong>
@{
    ViewData["Title"] = "Trang chủ";
    var banners = Model.Where(x => x.PhanLoai == 3).OrderByDescending(x => x.NgayTao).ToList();
    var camNhans = Model.Where(x => x.PhanLoai == 5).OrderByDescending(x => x.NgayTao).ToList();
    var baoChis = Model.Where(x => x.PhanLoai == 6).OrderByDescending(x => x.NgayTao).ToList();
}
@functions {
    // Hàm bóc tách ID Video Youtube từ Link bất kỳ
    public string LấyIdYoutube(string url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        var match = System.Text.RegularExpressions.Regex.Match(url, @"(?:youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*");
        return match.Success && match.Groups[1].Value.Length == 11 ? match.Groups[1].Value : "";
    }
}
@{
    var videoLon = ViewBag.VideoLon as VKITActivityManager.Models.Video;
    var videoNhoList = ViewBag.VideoNho as List<VKITActivityManager.Models.Video> ?? new List<VKITActivityManager.Models.Video>();

    // Lấy ID Youtube cho video lớn (nếu không có thì lấy tạm video nhỏ đầu tiên)
    string firstVideoId = videoLon != null ? LấyIdYoutube(videoLon.DuongDanVideo) : (videoNhoList.Any() ? LấyIdYoutube(videoNhoList.First().DuongDanVideo) : "");
}

<style>
