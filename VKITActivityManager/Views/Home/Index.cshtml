                                            <p class="card-text text-muted small kor-card-desc mb-4">@item.MoTa</p>
                                        }
                                    </div>

                                    <div class="pt-2">
                                        <div class="btn w-100 fw-bold d-flex align-items-center justify-content-center kor-btn-submit"
                                             style="--btn-color: var(--hb-color);">
                                            <span>Xem danh sách vinh danh</span>
                                            <i class="fas fa-arrow-right ms-2 kor-arrow"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

