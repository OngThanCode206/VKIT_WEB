            vertical-align: middle;
        }
</style>

<div id="vluHeroCarousel" class="carousel slide vlu-hero-carousel" data-bs-ride="carousel" data-bs-interval="2000" data-bs-pause="false">
    <div class="carousel-indicators mb-4">
        @for (int i = 0; i < banners.Count; i++)
        {
            <button type="button" data-bs-target="#vluHeroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
        }
    </div>
    <div class="carousel-inner">
        @if (banners.Any())
        {
            for (int i = 0; i < banners.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")"><img src="@banners[i].DuongDanAnh" class="vlu-banner-img" alt="Banner VKIT"></div>
            }
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#vluHeroCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
    <button class="carousel-control-next" type="button" data-bs-target="#vluHeroCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
</div>


@if (!string.IsNullOrEmpty(firstVideoId))
{
    <div class="container my-5 pt-2">
        <div class="video-main-container bg-white p-4 p-md-5 rounded-4 shadow-sm">

            <div class="row mb-5">
                <div class="col-12">
                    <div class="video-player-wrapper position-relative overflow-hidden rounded-4 shadow-sm" style="padding-top: 56.25%; background: #000;">
                        <iframe class="position-absolute top-0 start-0 w-100 h-100 border-0"
                                src="https://www.youtube.com/embed/@firstVideoId?rel=0&autoplay=1&mute=1"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                referrerpolicy="strict-origin-when-cross-origin"
                                allowfullscreen>
                        </iframe>
                    </div>
                    @if (videoLon != null)
                    {
                        <h3 class="fw-bold mt-4 text-center" style="color: #1a237e; text-transform: uppercase;">@videoLon.MoTaNgan</h3>
                    }
                </div>
            </div>

            <hr class="mb-5 text-muted" style="opacity: 0.15;" />

            <div class="d-flex align-items-center justify-content-between mb-4 mt-2">
                <h4 class="fw-bold m-0" style="color: #0A2540;">
                    <i class="fab fa-youtube text-danger me-2"></i> GÓC VIDEO VKIT
                </h4>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center video-nav-btn shadow-sm" id="btnPrevVideo" style="width: 40px; height: 40px;">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center video-nav-btn shadow-sm" id="btnNextVideo" style="width: 40px; height: 40px;">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div class="position-relative overflow-hidden">
                <div class="d-flex gap-4 pb-2" id="videoScrollArea" style="overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none;">
                    @foreach (var v in videoNhoList)
                    {
                        string yId = LấyIdYoutube(v.DuongDanVideo);
                        if (!string.IsNullOrEmpty(yId))
                        {
                            <div class="flex-shrink-0" style="width: 300px;">
                                <div class="position-relative rounded-4 shadow-sm overflow-hidden bg-dark mb-3 video-small-item"
                                     style="padding-top: 56.25%; cursor: pointer;" id="vid-container-@yId" onclick="playSmallVideo('@yId')">

                                    <img src="https://img.youtube.com/vi/@yId/mqdefault.jpg" class="position-absolute top-0 start-0 w-100 h-100 img-thumbnail-vid" style="object-fit: cover; transition: transform 0.3s ease;">

                                    <div class="position-absolute top-50 start-50 translate-middle text-white d-flex align-items-center justify-content-center play-btn-overlay"
                                         style="background: rgba(10, 37, 64, 0.8); width: 50px; height: 50px; border-radius: 50%; transition: all 0.3s;">
                                        <i class="fas fa-play ms-1"></i>
                                    </div>
                                </div>

                                <h6 class="fw-bold text-dark mb-1" style="line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@v.MoTaNgan</h6>

                            </div>
                        }
                    }
                </div>
            </div>

        </div>
    </div>

    <style>
        .video-small-item:hover .img-thumbnail-vid {
            transform: scale(1.05);
        }

        .video-small-item:hover .play-btn-overlay {
            background: #e53935 !important;
            transform: translate(-50%, -50%) scale(1.15);
        }

        #videoScrollArea::-webkit-scrollbar {
            display: none;
        }

        .video-nav-btn {
            border-color: #E2E8F0;
            color: #0A2540;
            background: #fff;
            transition: all 0.3s ease;
        }

            .video-nav-btn:hover {
                background-color: #0A2540;
                color: #ffffff;
                border-color: #0A2540;
            }

            .video-nav-btn:disabled {
                opacity: 0.4;
                cursor: not-allowed;
                background: #f8f9fa;
                color: #adb5bd;
                border-color: #e9ecef;
            }
    </style>

    <script>
        function playSmallVideo(videoId) {
            var container = document.getElementById('vid-container-' + videoId);
            if (container) {
                container.innerHTML = '<iframe class="position-absolute top-0 start-0 w-100 h-100 border-0" src="https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>';
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const scrollArea = document.getElementById('videoScrollArea');
            const btnPrev = document.getElementById('btnPrevVideo');
            const btnNext = document.getElementById('btnNextVideo');

            if (scrollArea && btnPrev && btnNext) {
                const scrollAmount = 324;

                btnNext.addEventListener('click', function () {
                    scrollArea.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });

                btnPrev.addEventListener('click', function () {
                    scrollArea.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                });

                scrollArea.addEventListener('scroll', function () {
                    btnPrev.disabled = scrollArea.scrollLeft <= 0;
                    btnNext.disabled = scrollArea.scrollLeft >= (scrollArea.scrollWidth - scrollArea.clientWidth - 2);
                });

                scrollArea.dispatchEvent(new Event('scroll'));
            }
        });
    </script>
}

<div class="container my-5 pt-4">
    <div class="text-center mb-5">
        <span class="section-badge"><i class="fas fa-fire text-danger me-1"></i> SỰ KIỆN & HOẠT ĐỘNG</span>
        <h2 class="k-main-title">Hoạt Động Nổi Bật</h2>
        <p class="section-subtitle">Những khoảnh khắc đáng nhớ và sự kiện tiêu biểu nhất của sinh viên Viện Công nghệ Việt - Hàn.</p>
    </div>

    @if (ViewBag.DanhSachHoatDongNoiBat != null)
    {
        var listHDNB = ((List<VKITActivityManager.Models.HoatDongNoiBat>)ViewBag.DanhSachHoatDongNoiBat).Take(10).ToList();

        <div class="position-relative hdnb-slider-wrapper py-3 px-md-4">
            <button id="btnPrevHDNB" class="btn btn-light rounded-circle shadow position-absolute top-50 translate-middle-y z-3" style="width: 45px; height: 45px; left: -15px;"><i class="fas fa-chevron-left"></i></button>

            <div class="d-flex gap-4 pb-3 hdnb-scroll-area" id="hdnbScrollArea" style="overflow-x: auto; scrollbar-width: none;">
                @foreach (var item in listHDNB)
                {
                    <div class="flex-shrink-0 hdnb-card-item">
                        <div class="advantage-card h-100" style="cursor: pointer;" data-img="@item.DuongDanAnh" data-caption="@item.MoTa" onclick="openLightbox(this)">
                            <div class="position-relative overflow-hidden mb-3" style="padding-top: 60%; border-radius: 12px;">
                                <img src="@item.DuongDanAnh" class="position-absolute top-0 start-0 w-100 h-100 hdnb-img" style="object-fit: cover; transition: 0.5s;" alt="Hoạt động">
                            </div>

                            <h5 class="advantage-title">@item.MoTa</h5>
                        </div>
                    </div>
                }
            </div>

            <button id="btnNextHDNB" class="btn btn-light rounded-circle shadow position-absolute top-50 translate-middle-y z-3" style="width: 45px; height: 45px; right: -15px;"><i class="fas fa-chevron-right"></i></button>
        </div>
    }
</div>

<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
