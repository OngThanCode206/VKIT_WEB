        text-transform: none;
        letter-spacing: -0.03em;
        margin-bottom: 60px;
        position: relative;
    }

        .testimonial-title::after {
            content: '';
            position: absolute;
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 40px;
            height: 3px;
