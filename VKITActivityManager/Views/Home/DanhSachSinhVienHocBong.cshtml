@model IEnumerable<VKITActivityManager.Models.SinhVienHocBong>
@{
    ViewData["Title"] = "Danh sách Sinh viên nhận học bổng";
}
<div class="container my-5 pt-3">
    <div class="text-center mb-5">
        <h2 class="fw-bold" style="color: @ViewBag.LoaiHocBong.MauNen;">DANH SÁCH VINH DANH</h2>
        <h4 class="text-muted">@ViewBag.LoaiHocBong.TenHocBong</h4>
    </div>

    <div class="row g-4">
        @if (Model.Any())
        {
            foreach (var sv in Model)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card student-card-square text-center border-0 shadow-sm h-100 rounded-4"
                         style="border-bottom: 5px solid @ViewBag.LoaiHocBong.MauNen !important;">

                        <img src="@(string.IsNullOrEmpty(sv.HinhAnh) ? "/images/default-avatar.png" : sv.HinhAnh)"
                             class="student-avatar-square" alt="@sv.TenSinhVien">

                        <div class="student-info-box">
                            <h5 class="fw-bold mb-1">@sv.TenSinhVien</h5>
                            <p class="text-muted small mb-3">MSSV: @sv.MaSV</p>
                            <div class="student-class-badge">
                                <span class="text-dark fw-bold" style="font-size: 0.9em;">@sv.Lop</span>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted fst-italic">Đang cập nhật danh sách sinh viên...</div>
        }
    </div>

    <div class="text-center mt-5">
        <a href="/" class="btn btn-outline-secondary px-4 rounded-pill">Quay lại trang chủ</a>
    </div>
</div>